mixin direction-catalog()
    .direction-catalog
        .direction-catalog__inner.container
            +header-catalog-card({
                src: 'assets/img/header-catalog/1.png',
                title: 'кухня'
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/2.png',
                title: 'Прачечная',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/3.png',
                title: 'Текстиль',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/4.png',
                title: 'Химия',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/5.png',
                title: 'Мебель',
            })