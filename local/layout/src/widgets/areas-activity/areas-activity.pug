mixin areas-activity()
    section.areas-activity
        .areas-activity__inner.container 
            h2.areas-activity__title Направления деятельности
            .areas-activity__list
                +areas-activity-card({
                    title: 'Профессиональные прачечные',
                    text: 'Комплексное оснащение прачечных в гостиницах, медицинских учреждениях и других специализированных объектах. Мы проектируем профессиональные прачечные и химчистки с оптимальной производительностью, которое включают: стиральное оборудование различной загрузк…',
                    src: 'assets/img/areas-activity/1.jpg',
                    src2x: 'assets/img/areas-activity/1@2x.jpg'
                })
                +areas-activity-card({
                    title: 'Текстиль для&nbsp;отелей',
                    text: 'Мы поставляем текстиль для отелей 3-5 звезд, медицинских учреждений, фитнес-центров и SPA-комплексов. Ассортимент включает изделия различных ценовых категорий – от экономичных решений до премиального текстиля международных стандартов. Мы сотрудничаем с лидерами текстильного…',
                    src: 'assets/img/areas-activity/2.jpg',
                    src2x: 'assets/img/areas-activity/2@2x.jpg'
                })
                +areas-activity-card({
                    title: 'Предприятия общ.питания',
                    text: 'Мы оснащаем предприятия общественного питания — от ресторанов высокой кухни до кафе, баров, столовых, пиццерий и fast-food. Разрабатываем профессиональные кухни с учётом специфики меню, производственных объёмов и технологических требований. Наши решения включают всё необходимое:…',
                    src: 'assets/img/areas-activity/3.jpg',
                    src2x: 'assets/img/areas-activity/3@2x.jpg'
                })
                +areas-activity-card({
                    title: 'Профессиональная химия',
                    text: 'Наш ассортимент включает высокоэффективные европейские химические средства и аксессуары для прачечных и химчисток, специальные средства для пятновыводки и аквачистки, дозирующие системы автоматической подачи химии. Мы предлагаем решения для различных типов…',
                    src: 'assets/img/areas-activity/4.jpg',
                    src2x: 'assets/img/areas-activity/4@2x.jpg'
                })
                +areas-activity-card({
                    title: 'Мебель',
                    text: 'Мы специализируемся на поставках как мягкой, так и корпусной мебели, предлагая разнообразные стили и решения от ведущих производителей. Мы поможем вам создать классический, современный, лофт, скандинавский или любой другой интерьер, отражающий вашу индивидуальность и…',
                    src: 'assets/img/areas-activity/5.jpg',
                    src2x: 'assets/img/areas-activity/5@2x.jpg'
                })
                +areas-activity-card({
                    title: 'Комплексное оснащение',
                    text: 'Комплексное оснащение ресторана, кафе, бара, кухни для обслуживания в номерах. Технологическое проектирование ресторана, подбор, поставка, пуско-наладка и сервисное обслуживание оборудования профессиональной кухни. Поставляем оборудование ведущих европейских брендов.',
                    src: 'assets/img/areas-activity/6.jpg',
                    src2x: 'assets/img/areas-activity/6@2x.jpg'
                })