                    src: 'assets/img/related-articles/3.jpg',
                    src2x: 'assets/img/related-articles/3@2x.jpg',
                    title: 'Как прошла выставка CleanExpo Moscow 2025',
                    date: '28.11.2025'
                })
                +related-article-item({
