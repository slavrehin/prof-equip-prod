mixin catalog-links-list()
    section.catalog-links-list
        .catalog-links-list__inner.container
            h2.catalog-links-list__title КАТАЛОГ
            .catalog-links-list__items 
                +catalog-link-card({
                    src: 'assets/img/catalog/1.jpg',
                    src2x: 'assets/img/catalog/1@2x.jpg',
                    title: 'БАРНОЕ ОБОРУДОВАНИЕ'
                })
                +catalog-link-card({
                    src: 'assets/img/catalog/2.jpg',
                    src2x: 'assets/img/catalog/2@2x.jpg',
                    title: 'ВИННЫЕ ШКАФЫ'
                })
                +catalog-link-card({
                    src: 'assets/img/catalog/3.jpg',
                    src2x: 'assets/img/catalog/3@2x.jpg',
                    title: 'ДЕФРОСТЕРЫ'
                })
                +catalog-link-card({
                    src: 'assets/img/catalog/4.jpg',
                    src2x: 'assets/img/catalog/4@2x.jpg',
                    title: 'КУХОННЫЕ ОСТРОВА'
                })
                +catalog-link-card({
                    src: 'assets/img/catalog/5.jpg',
                    src2x: 'assets/img/catalog/5@2x.jpg',
                    title: 'ЛИНИИ РАЗДАЧИ ПИТАНИЯ'
                })
                +catalog-link-card({
                    src: 'assets/img/catalog/6.jpg',
                    src2x: 'assets/img/catalog/6@2x.jpg',
                    title: 'ХОЛОДИЛЬНОЕ ОБОРУДОВАНИЕ'
                })
                +catalog-link-card({
                    src: 'assets/img/catalog/7.jpg',
                    src2x: 'assets/img/catalog/7@2x.jpg',
                    title: 'ЗАПЧАСТИ ДЛЯ КУХОННОГО ОБОРУДОВАНИЯ'
                })