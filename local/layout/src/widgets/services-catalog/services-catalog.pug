                title: 'Комплексное оснащение отелей и гостиниц',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/4.png',
                title: 'Поставка аксессуаров и запасных частей',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/5.png',
                title: 'Продажа оборудования',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/5.png',
                title: 'Сервисное обслуживание',
            })
            +header-catalog-card({
                src: 'assets/img/header-catalog/5.png',
