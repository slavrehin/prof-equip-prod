mixin advantages()
    section.advantages
        .advantages__inner.container 
            h2.advantages__title Преимущества
            .advantages__list 
                +advantage-card({
                    title: 'Комплексный подход <br>"Под ключ" ',
                    text: 'Мы решаем все задачи в рамках одного проекта – от концепции и проектирования до запуска и обучения персонала. Клиенту не нужно искать разных подрядчиков и координировать их работу.',
                    src: 'assets/img/advantages/1.png',
                    src2x: 'assets/img/advantages/1@2x.png',
                })
                +advantage-card({
                    title: 'Расширенная гарантия',
                    text: 'При комплексном оснащении объекта мы предоставляем расширенные условия гарантии: <br> • Увеличенный срок гарантийного обслуживания оборудования; <br> • Продленная гарантия на поставляемый текстиль.',
                    src: 'assets/img/advantages/2.png',
                    src2x: 'assets/img/advantages/2@2x.png',
                })
                +advantage-card({
                    title: 'Расширенная сервисная <br> поддержка ',
                    text: 'Собственный сервисный центр и склад запчастей позволяют быстро устранять неисправности и минимизировать простои оборудования. Предоставляем расширенную гарантию от PROF EQUIP при комплексном оснащении объекта.',
                    src: 'assets/img/advantages/3.png',
                    src2x: 'assets/img/advantages/3@2x.png',
                })
                +advantage-card({
                    title: 'Текстильные изделия <br> премиум-класса',
                    text: 'Наши полотенца прошли независимую проверку в международной гостиничной сети и превзошли ожидаемые стандарты. Мы — первый российский производитель махры, получивший такое признание. Полотенца рассчитаны на высокую нагрузку и имеют срок службы от 3 лет.',
                    src: 'assets/img/advantages/4.png',
                    src2x: 'assets/img/advantages/4@2x.png',
                })
                +advantage-card({
                    title: 'Оперативная доставка',
                    text: 'Быстро поставляем профессиональное оборудование, включая крупногабаритные позиции. Слаженная логистика, прямые контракты и отработанные процессы позволяют нам укладываться в сроки.',
                    src: 'assets/img/advantages/5.png',
                    src2x: 'assets/img/advantages/5@2x.png',
                })
                +advantage-card({
                    title: 'Работаем по всей России',
                    text: 'Работаем по всей России и странам СНГ. Наши офисы находятся в Москве, Сочи и Крыму, что обеспечивает оперативную поддержку клиентов в регионах.',
                    src: 'assets/img/advantages/6.png',
                    src2x: 'assets/img/advantages/6@2x.png',
                })