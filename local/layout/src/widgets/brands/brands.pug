mixin brands()
    section.brands
        .brands__inner.container 
            .brands__title-wrapper
                h2.brands__title Бренды
                +button().link__btn
                    span.eye__icon 
                        +svg('eye')
                    span.btn__text Все бренды
            .brands__list 
                +client-card({
                    src: 'assets/img/brands/1.png',
                    src2x: 'assets/img/brands/1@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/2.png',
                    src2x: 'assets/img/brands/2@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/3.png',
                    src2x: 'assets/img/brands/3@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/4.png',
                    src2x: 'assets/img/brands/4@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/5.png',
                    src2x: 'assets/img/brands/5@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/6.png',
                    src2x: 'assets/img/brands/6@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/7.png',
                    src2x: 'assets/img/brands/7@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/8.png',
                    src2x: 'assets/img/brands/8@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/9.png',
                    src2x: 'assets/img/brands/9@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/10.png',
                    src2x: 'assets/img/brands/10@2x.png',
                })
                +client-card({
                    src: 'assets/img/brands/11.png',
                    src2x: 'assets/img/brands/11@2x.png',
                })