mixin objects()
    section.objects
        .objects__inner.container
            h3 Другие объекты
            .objects__swiper
                .swiper-wrapper
                    a(href="#").swiper-slide
                        .image-wrapper
                            +img({
                                src: 'assets/img/objects/1.jpg',
                                src2x: 'assets/img/objects/1@2x.jpg',
                                alt: 'object',
                            })
                        .object__content 
                            p.object__title Отель RUMA
                            p.object__date 24.03.2025
                    a(href="#").swiper-slide
                        .image-wrapper
                            +img({
                                src: 'assets/img/objects/2.jpg',
