mixin articles-swiper()
    section.articles-swiper-wrapper 
        .articles-swiper-wrapper__inner.container
            h2.articles-swiper__title СТАТЬИ ДЛЯ ОТЕЛЬЕРОВ 
            .articles-swiper
                .swiper-wrapper 
                    a(href="#").swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/articles-swiper/1.jpg',
                                src2x: 'assets/img/articles-swiper/1@2x.jpg',
                                alt: 'article'
                            })
                        .article-card__content 
                            p.article__title Организация линии раздачи в отеле: проектирование, оснащение и запуск
                            p.article__link Подробнее
                                +svg('arrow-right-fill')
                    a(href="#").swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/articles-swiper/2.jpg',
                                src2x: 'assets/img/articles-swiper/2@2x.jpg',
                                alt: 'article'
                            })
                        .article-card__content 
                            p.article__title Прачечная в отеле с нуля: планирование, оснащение, запуск
                            p.article__link Подробнее
