mixin projects-list()
    section.projects-list
        .projects-list__inner.container 
            +title-block({
                title: 'Проекты',
                breadcrumbs: [
                    {
                        href: 'home.html',
                        title: 'Главная'
                    },
                    {
                        href: 'projects.html',
                        title: 'Проекты'
                    }
                ]
            })
            .projects-list__filters 
                button.btn.filter.active(data-filter='0') Показать все
                button.btn.filter(data-filter='1') Ресторан
                button.btn.filter(data-filter='2') Гостиница
                button.btn.filter(data-filter='3') Аквачистка
                button.btn.filter(data-filter='4') Прачечная
                button.btn.filter(data-filter='5') Кухня
                button.btn.filter(data-filter='6') Текстиль
                button.btn.filter(data-filter='7') Химия
                button.btn.filter(data-filter='8') Туннельная прачечная
                button.btn.filter(data-filter='9') Стадион
                button.btn.filter(data-filter='10') Санаторий
                button.btn.filter(data-filter='11') Казино
            .projects-list__content 
                .grid-sizer
                a(href="#" data-filter='0 1').project__item.grid-item
