mixin work-stages()
    .work-stages
        .work-stages__inner.container
            h2.work-stages__title Этапы работы
            .work-stages__list 
                +work-stage-card({
                    src: 'assets/img/work-stages/1.png',
                    src2x: 'assets/img/work-stages/1@2x.png',
                    number: '01',
                    title: 'Консалтинг',
                    text: 'Мы предоставляем бесплатные консультации на всех этапах планирования проекта. Наши эксперты помогают определить оптимальное техническое решение, рассчитать экономическую эффективность инвестиций и выбрать оборудование под конкретные задачи бизнеса.'
                })
                +work-stage-card({
                    src: 'assets/img/work-stages/2.png',
                    src2x: 'assets/img/work-stages/2@2x.png',
                    number: '02',
                    title: 'Техническое проектирование',
                    text: 'Собственное проектное бюро ПРОФЭКВИП выполняет технологическое проектирование предприятий любой сложности с учетом всех нормативных требований и особенностей бизнеса клиента. Мы разрабатываем планировочные решения, технологические схемы, инженерные системы, составляем спецификации оборудования и техническую документацию. Наши проекты оптимизированы под российские условия эксплуатации и соответствуют всем санитарным и противопожарным нормам.'
                })
                +work-stage-card({
                    src: 'assets/img/work-stages/3.png',
                    src2x: 'assets/img/work-stages/3@2x.png',
                    number: '03',
                    title: 'Поставка и логистика',
                    text: 'Мы самостоятельно организуем поставки и логистику, контролируя весь процесс от склада производителя до объекта заказчика. Собственная логистическая служба обеспечивает своевременную доставку, правильное хранение и транспортировку оборудования. Мы работаем напрямую с производителями, что позволяет предлагать конкурентные цены и гарантировать оригинальность поставляемой продукции.'
                })
                +work-stage-card({
                    src: 'assets/img/work-stages/4.png',
                    src2x: 'assets/img/work-stages/4@2x.png',
                    number: '04',
                    title: 'Сервисный центр и запчасти',
                    text: 'Наша сервисная служба выполняет пуско-наладочные работы, обеспечивает гарантийное и послегарантийное обслуживание любого оборудования. Собственный склад запчастей позволяет оперативно устранять неисправности, минимизируя простои оборудования.'
                })
                +work-stage-card({
                    src: 'assets/img/work-stages/5.png',
                    src2x: 'assets/img/work-stages/5@2x.png',
                    number: '05',
                    title: 'Профессиональное обучение персонала',
                    text: 'Мы проводим обучение операторов работе с прачечным оборудованием и профессиональными химическими средствами. Подготовка специалистов осуществляется как на нашей базе, так и на заводах-производителях оборудования. Программы обучения включают теоретическую подготовку, практические занятия.'
                })