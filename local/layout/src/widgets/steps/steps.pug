mixin steps()
    section.steps
        .steps__inner.container 
            h2.steps__title ЭТАПЫ КОМПЛЕКСНОГО ОСНАЩЕНИЯ
            .steps__list 
                +steps-item({
                    src: 'assets/img/steps/1.svg',
                    title: 'Консалтинг',
                    text: 'Консультации по вопросам выбора оборудования, его особенностей и технологической мощности, советы по проектированию и расстановке оборудования на объекте.'
                })
                +steps-item({
                    src: 'assets/img/steps/2.svg',
                    title: 'Монтаж',
                    text: 'Монтаж на объектах питания осуществляют квалифицированные специалисты собственной сервисной службы «Профитекс», прошедшие обучение и сертификацию за рубежом на заводах производителей.'
                })
                +steps-item({
                    src: 'assets/img/steps/3.svg',
                    title: 'Проработка технического задания',
                    text: 'Проработка детализированной спецификации согласно технического задания клиента, расстановка и первичная подготовка плана объекта питания.'
                })
                +steps-item({
                    src: 'assets/img/steps/4.svg',
                    title: 'Запуск и пусконаладочные работы',
                    text: 'Подключение оборудования к сети 220/380 Вт, холодной и горячей воде, тестовый запуск оборудования, калибровка по необходимости.'
                })
                +steps-item({
                    src: 'assets/img/steps/5.svg',
                    title: 'Проектирование',
                    text: 'Технологическое проектирование осуществляется усилиями собственного проектного бюро, основанного в 2009 году. Правильно организованное начало процесса служит гарантией успешности дальнейших этапов и всего проекта в целом.'
                })
                +steps-item({
                    src: 'assets/img/steps/6.svg',
                    title: 'Вводное обучение персонала',
                    text: 'По необходимости сервисная служба проводит вводное обучение для персонала, которое раскрывает особенности использования оборудования профессиональной кухни.'
                })
                +steps-item({
                    src: 'assets/img/steps/7.svg',
                    title: 'Согласование',
                    text: 'Согласование предложенной спецификации и расстановки на объекте. Согласование предложенных брендов и моделей оборудования, а также их стоимости.'
                })
                +steps-item({
                    src: 'assets/img/steps/8.svg',
                    title: 'Гарантийное и послегарнтийное обслуживание',
                    text: 'Систематический техосмотр позволяет продлить срок службы оборудования профессиональной кухни, предотвращает дорогостоящие поломки и выход из рабочего состояния.'
                })
                +steps-item({
                    src: 'assets/img/steps/9.svg',
                    title: 'Логистика оборудования',
                    text: 'Логистика оборудования с заводов производителей до объекта заказчика, погрузо- разгрузочные работы на объекте.'
                })
                +steps-item({
                    src: 'assets/img/steps/10.svg',
                    title: 'Поставка аксессуаров и запчастей для профессионального оборудования',
                    text: 'При заключении сервисного договора – поставка запасных частей для оборудования профессиональной кухни.'
                })