mixin complete-solution()
    section.complete-solution
        .complete-solution__inner.container
            +title-block({
                title: 'Готовые решения',
                breadcrumbs: [
                    {
                        href: 'home.html',
                        title: 'Главная'
                    },
                    {
                        href: 'complete-solution.html',
                        title: 'Готовые решения'
                    }
                ]
            })
            .complete-solution__list
                +complete-solution-item({
                    src: 'assets/img/complete-solution/1.jpg',
                    src2x: 'assets/img/complete-solution/1@2x.jpg',
                    title: 'Индустриальная прачечная с туннельной линией',
                    descr: 'Специалисты компании ПРОФЭКВИП осуществили проектирование промышленной прачечной с туннельной линией в Москве. Проект…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/2.jpg',
                    src2x: 'assets/img/complete-solution/2@2x.jpg',
                    title: 'Коммерческая прачечная',
                    descr: 'Коммерческая прачечная является выгодным капиталовложением. Сегодня число таких прачечных в нашей стране очень…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/3.jpg',
                    src2x: 'assets/img/complete-solution/3@2x.jpg',
                    title: 'Барная стойка',
                    descr: 'Сегодня барная стойка является одной из визитных карточек заведения, будь то ресторан, кафе…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/4.jpg',
                    src2x: 'assets/img/complete-solution/4@2x.jpg',
                    title: 'Кухня на заправочной станции (АЗС)',
                    descr: 'Закусочная с горячими хот-догами, гамбургерами, пирожками и бодрящим кофе – неотъемлемая часть современной…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/5.jpg',
                    src2x: 'assets/img/complete-solution/5@2x.jpg',
                    title: 'Кухня в гостинице',
                    descr: 'Основной ресторан в гостинице проектируется как отдельное полноценное помещение. В нем же, чаще…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/6.jpg',
                    src2x: 'assets/img/complete-solution/6@2x.jpg',
                    title: 'Открытая кухня',
                    descr: 'Вынесение кухни ресторанов и кафе на всеобщее обозрение является сейчас заметной тенденцией работы…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/7.jpg',
                    src2x: 'assets/img/complete-solution/7@2x.jpg',
                    title: 'Фаст-фуд',
                    descr: 'Сектор HoReCa является одним из самых быстрорастущих. Тенденции развития объектов общественного питания во…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/8.jpg',
                    src2x: 'assets/img/complete-solution/8@2x.jpg',
                    title: 'Проект прачечной на предприятии',
                    descr: 'Уход за униформой и спецодеждой современного предприятия требует квалифицированного подхода к технологии стирки…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/9.jpg',
                    src2x: 'assets/img/complete-solution/9@2x.jpg',
                    title: 'Промышленная прачечная',
                    descr: 'Промышленная (индустриальная) прачечная представляет собой комплекс взаимосвязанных машин для транспортировки, стирки, сушки, глажки,…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/10.jpg',
                    src2x: 'assets/img/complete-solution/10@2x.jpg',
                    title: 'Мини-прачечная',
                    descr: 'Открытие мини-прачечной – хорошее решение для небольшого ресторана, кафе, гостиницы, а также для прачечной…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/11.jpg',
                    src2x: 'assets/img/complete-solution/11@2x.jpg',
                    title: 'Аквачистка',
                    descr: 'Предлагаем Вам открыть аквачистку — современную экологическую альтернативу химчистки. В последнее время все…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/12.jpg',
                    src2x: 'assets/img/complete-solution/12@2x.jpg',
                    title: 'Прачечная в больнице',
                    descr: 'К стирке больничного белья предъявляются особые требования, чтобы исключить возможность контакта чистого белья…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/13.jpg',
                    src2x: 'assets/img/complete-solution/13@2x.jpg',
                    title: 'Готовый проект прачечной в гостинице',
                    descr: 'Наличие собственной прачечной в гостинице позволяет получить ряд преимуществ, основными из которых являются:…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/14.jpg',
                    src2x: 'assets/img/complete-solution/14@2x.jpg',
                    title: 'Прачечная в фитнес-клубе',
                    descr: 'Фитнес-клуб нуждается в качественной стирке и сушке махровых изделий. Профессиональное полотенце способно прослужить…'
                })
                +complete-solution-item({
                    src: 'assets/img/complete-solution/15.jpg',
                    src2x: 'assets/img/complete-solution/15@2x.jpg',
                    title: 'Открыть химчистку',
                    descr: 'Открыть химчистку Если рассматривать химчистку как бизнес, то потенциал рынка огромен. Рынок химчисток…'
                })