mixin chemistry-steps()
    section.chemistry-steps
        .chemistry-steps__inner.container 
            h2.chemistry-steps__title ЭТАПЫ СОТРУДНИЧЕСТВА
            .chemistry-steps__list
                .row
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/1.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 1. Аудит прачечной
                            p.descr Изучение всех процессов, анализ энергоресурсов
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/2.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 2. Анализ проведенного аудита
                            p.descr Выявление проблем и решений
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/3.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 3. Составление КП
                            p.descr Включая рекомендации по технологии стирки
                    .chemistry-step__item 
                        .image-wrapper
                            +img({
                                src: 'assets/img/chemistry-steps/4.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 4. Пробный период тестирования
                            p.descr Работа с различными загрязнениями
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/5.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 5. Подбор и установка дозирующего оборудования
                .row
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/6.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 6. Налаживание всех процессов на прачечной
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/7.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 7. Подготовка и тестирование сотрудников прачечной
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/8.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 8. Контроль качества стирки различных изделий
                    .chemistry-step__item 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/chemistry-steps/9.png',
                                alt: 'step'
                            })
                        .chemistry-step__content 
                            p.title 9. Регулярные поставки профессиональной химии