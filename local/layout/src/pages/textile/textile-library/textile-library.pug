mixin textile-library()
    section.textile-library
        .textile-library__inner.container 
            h2.textile-library__title БИБЛИОТЕКА ТЕКСТИЛЯ
            .textile-library-swiper 
                .swiper-wrapper 
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-library/1.jpg',
                                src2x: 'assets/img/textile-library/1@2x.jpg',
                                alt: 'library'
                            })
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-library/2.jpg',
                                src2x: 'assets/img/textile-library/2@2x.jpg',
                                alt: 'library'
                            })
                    .swiper-slide 
