mixin textile-form()
    section.textile-form
        .textile-form__bg 
            +img({
                src: 'assets/img/textile-form/bg.jpg',
                src2x: 'assets/img/textile-form/bg@2x.jpg',
                alt: 'bg'
            })
        .textile-form__inner.container 
            h2.textile-form__title ПРОФЕССИОНА&shy;ЛЬНЫЙ ТЕКСТИЛЬ <br> ДЛЯ ОТЕЛЕЙ & РЕСТОРАНОВ
            +calculate-project({hasBg: true})