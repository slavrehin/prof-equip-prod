mixin textile-trusted()
    section.textile-trusted
        .textile-trusted__inner.container
            h2.textile-trusted__title НАМ ДОВЕРЯЮТ
            .textile-trusted-swiper 
                .swiper-wrapper 
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-trusted/1.jpg',
                                src2x: 'assets/img/textile-trusted/1@2x.jpg',
                                alt: 'trusted'
                            })
                        .trusted__content 
                            p.title Отель RUMA
                            p.link Подробнее
                                +svg('arrow-right-fill')
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-trusted/2.jpg',
                                src2x: 'assets/img/textile-trusted/2@2x.jpg',
                                alt: 'trusted'
                            })
                        .trusted__content 
                            p.title VLADIVOSTOK Grand Hotel & SPA
                            p.link Подробнее
                                +svg('arrow-right-fill')
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-trusted/3.jpg',
                                src2x: 'assets/img/textile-trusted/3@2x.jpg',
                                alt: 'trusted'
                            })
                        .trusted__content 
                            p.title Riviera Wellness Resort
                            p.link Подробнее
                                +svg('arrow-right-fill')
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-trusted/4.jpg',
                                src2x: 'assets/img/textile-trusted/4@2x.jpg',
                                alt: 'trusted'
                            })
                        .trusted__content 
                            p.title MANTERA Supreme Seaside 5*
                            p.link Подробнее
                                +svg('arrow-right-fill')
                    .swiper-slide 
                        .image-wrapper 
                            +img({
                                src: 'assets/img/textile-trusted/1.jpg',
                                src2x: 'assets/img/textile-trusted/1@2x.jpg',
                                alt: 'trusted'
                            })
                        .trusted__content 
