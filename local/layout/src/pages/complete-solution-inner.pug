extends @/app/templates/template.pug
block head 
  +head()

block header 
    +header().black
block content
    main
        +text-block()
            h1.text-block__title ПРОФЭКВИП на RUVIERA Hotel Business Week 2025
            +breadcrumbs([
                {
                    href: 'home.html',
                    title: 'Главная'
                },
                {
                    href: 'complete-solution.html',
                    title: 'Готовые решения'
                },
                {
                    href: 'news-inner.html',
                    title: 'Кухня на заправочной станции (АЗС)'
                },
            ])
           
            p Закусочная с горячими хот-догами, гамбургерами, пирожками и бодрящим кофе – неотъемлемая часть современной заправочной станции. Представленное готовое решение – пример оснащения небольшой кухни на заправочной станции (АЗС) технологическим оборудованием. Так как площадь помещения автозаправочной станции, как правило, невелика, важно на начальном этапе правильно распределить зоны зала, кухни, торговых витрин и т.д.
            p Посещение кафе обычно не является основной целью посетителя, но аромат свежей выпечки и кофе, наверняка, вызовет его интерес. А здесь уже важно качество и скорость обслуживания. Качество обеспечивает персонал, а удержать внимание и обеспечить высокую скорость обслуживания может помочь технологическое кухонное оборудование – удобные и презентабельные демонстрационные витрины, хорошая кофемашина, микроволновая печь повышенной мощности.
            .text-block__images-swiper
                .swiper-wrapper 
                    .image-wrapper.swiper-slide 
                        +img({
                            src: 'assets/img/complete-solution-inner/1.png',
                            src2x: 'assets/img/complete-solution-inner/1@2x.png',
                            alt: 'complete solution'
                        })
                    .image-wrapper.swiper-slide 
                        +img({
                            src: 'assets/img/complete-solution-inner/2.png',
                            src2x: 'assets/img/complete-solution-inner/2@2x.png',
                            alt: 'complete solution'
                        })
                    .image-wrapper.swiper-slide 
                        +img({
                            src: 'assets/img/complete-solution-inner/3.png',
                            src2x: 'assets/img/complete-solution-inner/3@2x.png',
                            alt: 'complete solution'
                        })
                .pagination
                .navigation 
                    +button().text-block__prev
                        +svg('arrow-swiper-left')
                    +button().text-block__next
                        +svg('arrow-swiper-right')
            .text-block__info 
                .info__item 
                    h2.info__title ОПИСАНИЕ ПРОЕКТА
                    ul 
                        li Предварительная обработка и приготовление: настольные фритюрницы, двухконфорочные плиты с инфракрасным нагревом, слайсер, планетарный миксер;
                        li Хранение продуктов: холодильный и морозильный шкафы и камеры с комплектом стеллажей;
                        li Мойка посуды в отдельном помещении: фронтальная посудомоечная машина, ванны моечные, стеллажи для хранения посуды;
                        li Линия выдачи: торговые витрины, технологическое оборудование для подогрева и приготовления пищи (конфекционная печь и расстоечный шкаф, скоростной панини-гриль, микроволновая печь, станция для приготовления хот-догов с установленным роликовым грилем для сосисок;
                        li Приготовление горячих напитков: суперкофеавтомат с модулем для молока и подогревом чашек;
                        li Презентация холодных напитков: демонстрационная холодильная камера со стеклянными дверцами и стеллажами.
                .info__item 
                    h2.info__title ВАЖНО ЗНАТЬ
                    p Максимальная эффективность работы кухни в условиях ограниченного пространства и высокая скорость обслуживания клиентов – главные аспекты, на которые стоит ориентироваться при оснащении кухни заправочной станции.
                    ul 
                        li На АЗС для кухни отводится небольшая площадь, поэтому спектр используемого профессионального кухонного оборудования невелик – оно должно максимально отвечать задачам кухни;
                        li Высокая скорость работы персонала – важный аспект для АЗС: используйте мощное производительное оборудование, которое сократит время приготовления блюд и напитков;
                        li Сократите время заполнения полок с напитками и закусками с помощью демонстрационных холодильных камер с удобными стеклянными дверцами.
            p В запросе на просчет стоимости проекта и оснащения кухни на заправочной станции (АЗС) изложите все исходные данные, требования и пожелания. Специалисты ПРОФЭКВИП подготовят персональное предложение, отвечающее вашим требованиям и заявленному бюджету.
            p Получите индивидуальные рекомендации профессионалов комплексного оснащения объектов питания прямо сейчас!
        +calculate-project({hasBg: true})
        +navigation-links({
            title1: 'Система таблет питания',
            title2: 'Как наладить контакт между кухней и залом в ресторане',
        })
        +related-articles()
block footer 
    +footer()