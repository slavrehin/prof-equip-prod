mixin equipment-about()
    .equipment-about
        .equipment-about__inner.container 
            +equipment-about-item({
                src: 'assets/img/equipment-about/1.png',
                src2x: 'assets/img/equipment-about/1@2x.png',
                title: 'ОСНАЩЕНИЕ ТОЧЕК ПИТАНИЯ В ОТЕЛЕ',
                descr: 'Комплексное оснащение ресторана, кафе, бара, кухни для обслуживания в номерах. Технологическое проектирование ресторана, подбор, поставка, пуско-наладка и сервисное обслуживание оборудования профессиональной кухни. Поставляем оборудование ведущих европейских брендов.'
            }).text-left
            +equipment-about-item({
                src: 'assets/img/equipment-about/2.png',
                src2x: 'assets/img/equipment-about/2@2x.png',
                title: 'ПРОФЕССИОНА&shy;ЛЬНЫЙ ТЕКСТИЛЬ И УНИФОРМА',
                descr: 'Предлагаем профессиональный текстиль для сетевых отелей, гостиниц. Осуществляем поставку прямого белья, постельных принадлежностей, махровых изделий, униформы, а также кроватных оснований и матрасов для оснащения номерного фонда.'
            }).text-right
            +equipment-about-item({
                src: 'assets/img/equipment-about/3.png',
                src2x: 'assets/img/equipment-about/3@2x.png',
                title: 'ПРАЧЕЧНАЯ В ГОСТИНИЦЕ',
                descr: 'Проектирование и оснащение прачечной/постирочной, химчистки, аквачистки в гостинице. Обучаем персонал, разрабатываем технологию стирки и снабжаем профессиональной химией. Являемся официальными дилерами TOLON, JENSEN, MACPI, IMESA, PONY, SOVRANA, ELECTROLUX.'
            }).text-left