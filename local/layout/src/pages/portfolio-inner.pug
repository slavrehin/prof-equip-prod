extends @/app/templates/template.pug
block head 
  +head()

block header 
    +header().black
block content
    main
        +portfolio-inner-hero({
            title: 'ООО “РТК”',
            src: 'assets/img/portfolio-inner-hero/1.png',
            src2x: 'assets/img/portfolio-inner-hero/1@2x.png',
        })
            block text 
                p ООР “РТК” – ведущая сервисная компания, специализирующаяся на комплексном обслуживании пассажирского комплекса ОАО “РЖД”. Компания предоставляет широкий спектр услуг: от клининга и стирки белья до технического обслуживания зданий и сооружений. Среди клиентов РТК не только структуры РЖД, но и крупные аэропорты, торговые и логистические компании.
                strong О проекте
                p В рамках проекта модернизации производственных мощностей специалисты ПРОФЭКВИП осуществили полный комплекс работ по оснащению прачечного комплекса на платформе Северянин в Москве.
                p Ключевым элементом проекта стала установка высокопроизводительной туннельной стиральной линии ALPHA с впечатляющей производительностью – 2000 кг белья в час.
                p Наши инженеры выполнили проектирование, поставку и монтаж оборудования, а также провели профессиональную дефектовку существующего оборудования с последующей поставкой необходимых запчастей.
            block info
                p 
                    strong Начало сотрудничества:&nbsp; 
                    | 2024 год<br>
                    strong Поставленное оборудование:
                ul 
                    li Загрузочный наклонный конвейер ALPHA C5-L
                    li Туннельная стиральная машина ALPHA TW5-14
                    li Отжимной пресс ALPHA P5 60 Plus
                    li Подъёмный конвейер одиночной загрузки ALPHA C5-S
                    li Челночно-подъёмный конвейер одинарной загрузки ALPHA C5-S
                    li Индустриальный тактовый проходной сушильный барабан ALPHA by JENSEN D5-60
                    li Соединительное управление ALPHA “MULTI”
                    li Индустриальная машина подачи ALPHA F10
                    li Гладильный каток ALPHA I5
                    li Индустриальная машина для складывания ALPHA X5 D/E-3
                    li Штабелёр Compact модель I
        +portfolio-swiper()
        +calculate-project({hasBg: true})
        +navigation-links({
            title1: 'MANTERA Supreme Seaside 5*',
            title2: 'Прачечная “Стандарт чистоты”',
        })
        +another-objects()
block footer 
    +footer()