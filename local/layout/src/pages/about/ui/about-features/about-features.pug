mixin about-features()
    section.about-features
        .about-features__inner.container 
            +about-feature-item({
                icon: "assets/img/about-features/1.svg",
                number: '4',
                title: 'НАПРАВЛЕНИЙ ДЕЯТЕЛЬНОСТИ'
            })
            +about-feature-item({
                icon: "assets/img/about-features/2.svg",
                number: '985',
                title: 'РЕАЛИЗОВАННЫХ ПРОЕКТОВ'
            })
            +about-feature-item({
                icon: "assets/img/about-features/3.svg",
                number: '53',
                title: 'ПОРТФЕЛЬ БРЕНДОВ'
            })